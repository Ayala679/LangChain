# Copy this file to .env and fill in your own keys.
# .env is git-ignored - anyone running this project needs their own.
# NEVER put a real key in this file - it is committed to git.

GEMINI_API_KEY=your_gemini_key_here     # Free key: https://aistudio.google.com/apikey
TAVILY_API_KEY=your_tavily_key_here     # Free key: https://app.tavily.com/

# ── Optional overrides ───────────────────────────────────────────────
# GEMINI_MODEL=gemini-flash-lite-latest
# TAVILY_MAX_RESULTS=5

# Set to 0 to re-enable TLS verification. Leave at 1 when you are behind
# a TLS-inspecting proxy such as Netfree.
# INSECURE_SSL=1
